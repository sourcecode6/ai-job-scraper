# ─────────────────────────────────────────────
# Gmail SMTP (use an App Password — NOT your regular Gmail password)
# Guide: myaccount.google.com → Security → 2-Step Verification → App passwords
# ─────────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Where job match digests are sent (usually same as EMAIL_USER)
NOTIFY_EMAIL=your_email@gmail.com

# ─────────────────────────────────────────────
# HuggingFace Offline settings (zero API key setup)
# ─────────────────────────────────────────────
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# ─────────────────────────────────────────────
# App settings (defaults are good for most use cases)
# ─────────────────────────────────────────────
PORT=3000
MATCH_THRESHOLD=65
DATA_RETENTION_DAYS=3
SCRAPE_INTERVAL_HOURS=6

# Set to true to bypass robots.txt restrictions specifically on api.smartrecruiters.com
ALLOW_ARISTA_BYPASS=false

